# Java Configuration
# Spark 4.0.2-SNAPSHOT requires Java 17 runtime
# If your system default is not Java 17, uncomment these lines:
export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
export PATH=$JAVA_HOME/bin:$PATH

# Unity Catalog Configuration
UC_URI=https://your-databricks-workspace.cloud.databricks.com
UC_TOKEN=dapi... # Your Databricks Personal Access Token

# Table Configuration
CATALOG_NAME=your_catalog
SCHEMA=your_schema
TABLE=your_table
TABLE_LOCATION=s3://your-bucket/path/to/table
